# Docker ignore file - excludes files from Docker build context

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist
build
.next
out

# Development files
.git
.gitignore
.github
.vscode
.idea

# Environment files (should be passed as build args or runtime env vars)
.env
.env.local
.env.*.local

# Testing
coverage
.nyc_output
*.lcov

# Documentation
*.md
!README.md
docs/

# CI/CD
.gitlab-ci.yml
.travis.yml
.circleci/

# Misc
.DS_Store
Thumbs.db
*.log
.cache

# Docker files (don't need to copy into image)
Dockerfile
docker-compose*.yml
.dockerignore
